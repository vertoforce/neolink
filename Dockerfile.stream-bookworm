# Bookworm build of the `neolink` binary, for PIPE MODE ONLY.
#
# 2026-09-10: the production image (Dockerfile, `neolink:stream1`) is Debian
# TRIXIE (glibc 2.41). Frigate's image — which is where go2rtc runs and
# therefore where the `exec:` child is spawned — is Debian BOOKWORM with
# glibc 2.36 (measured: `docker exec frigate ldd --version`). A trixie-built
# binary cannot run there. So the binary that gets bind-mounted into Frigate is
# built HERE against bookworm, and `stream-runtime/` is extracted from this
# image.
#
# gst-rtsp-server is still LINKED (src/rtsp is compiled in and unchanged) but
# is never CALLED in `neolink stream` — the muxer in src/stream/mpegts.rs is
# hand-rolled Rust. That is why bookworm's gst 1.22 is acceptable here and the
# `>= 1.24.9` runtime guard in the trixie Dockerfile is deliberately absent:
# the dead-camera SIGABRT vector it guards (gst_rtsp_media_get_rates) lives on
# the RTSP path, which pipe mode does not enter.
#
# 2026-09-10: pipe mode DOES now call GStreamer, for one thing only — the
# ADPCM -> AAC transcode in src/stream/aac.rs (appsrc ! audioconvert !
# audioresample ! voaacenc ! aacparse ! appsink). MPEG-TS has no ADPCM stream
# type, so without it the muxer emits a video-only PMT and camera A + camera C
# lose the audio the RTSP path used to carry. The plugin packages below are
# therefore no longer incidental dependencies: `extract-stream-runtime.sh`
# copies six specific plugin .so files out of this image, and the transcoder
# refuses to advertise an audio track it cannot produce if they are absent.
#
# Build:  docker build -f Dockerfile.stream-bookworm -t neolink:stream1-bookworm .
# Extract: ./extract-stream-runtime.sh
FROM docker.io/rust:slim-bookworm@sha256:ebd900bae66fd508b466cef82d64a83a5fb34682e4c8b2797a42908bddc95a57 AS build

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /usr/local/src/neolink
COPY . /usr/local/src/neolink

# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      openssl \
      libssl-dev \
      ca-certificates \
      libgstrtspserver-1.0-dev \
      libgstreamer1.0-dev \
      libgtk2.0-dev \
      protobuf-compiler \
      libglib2.0-dev && \
    apt-get clean -y && rm -rf /var/lib/apt/lists/* ; \
    pkg-config --modversion gstreamer-rtsp-server-1.0 ; \
    cargo build --release

# Optional target: `docker build -f Dockerfile.stream-bookworm --target test .`
# runs the 24 stream-module unit tests against the same compiled tree:
# 8 clock/wrap/anchor/track-layout (src/stream/mod.rs), 4 muxer (mpegts.rs), 6 ADPCM decode
# (adpcm.rs) and 6 AAC (aac.rs, including a real ADPCM -> voaacenc -> ADTS
# encode, which is why the plugin packages are installed in this stage too).
FROM build AS test
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
      gstreamer1.0-plugins-bad && \
    apt-get clean -y && rm -rf /var/lib/apt/lists/*
# `| tail` on its own would swallow a non-zero exit and silently pass a
# failing test stage, so the log is captured and the status checked.
RUN cargo test --release stream:: > /tmp/stream-tests.log 2>&1 \
      || { tail -60 /tmp/stream-tests.log ; exit 1 ; } ; \
    tail -30 /tmp/stream-tests.log

FROM docker.io/debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

# The `for so in ...` guard fails the image rather than shipping a runtime the
# transcoder cannot use. voaacenc is the only AAC encoder in bookworm's plugin
# set (fdkaacenc is not built; avenc_aac lives in gstreamer1.0-libav, whose
# libav* closure is an order of magnitude more to bind-mount into Frigate).
# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssl \
        ca-certificates \
        libgstrtspserver-1.0-0 \
        libgstreamer1.0-0 \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-bad && \
    apt-get clean -y && rm -rf /var/lib/apt/lists/* ; \
    for so in libgstapp libgstaudioconvert libgstaudioresample \
              libgstaudioparsers libgstvoaacenc libgstcoreelements ; do \
      test -f "/usr/lib/x86_64-linux-gnu/gstreamer-1.0/$so.so" \
        || { echo "MISSING GStreamer plugin $so.so" >&2 ; exit 1 ; } ; \
    done

COPY --from=build \
  /usr/local/src/neolink/target/release/neolink \
  /usr/local/bin/neolink

RUN chmod +x /usr/local/bin/neolink && /usr/local/bin/neolink --version
